{
  "hardcodedPatches": {
    "remove-unused-data-type-templates": {
      "enabled": true,
      "extensions": ["icd", "iid"]
    },
    "add-empty-lpl-das": {
      "enabled": false,
      "extensions": ["scd"]
    },
    "add-enum-default-values": {
      "enabled": false,
      "extensions": ["icd", "iid"]
    },
    "expand-single-val-sgroups": false,
    "truncate-desc-255": {
      "enabled": false,
      "extensions": ["scd"]
    },
    "schneider-redundant-ethernet": {
      "enabled": false,
      "extensions": ["scd"]
    },
    "schneider-sv-cb-ref-normalization": true,
    "schneider-clientln-order": {
      "enabled": true,
      "extensions": ["scd"]
    }
  },
  "rules": [
    {
      "action": "delete",
      "enabled": true,
      "extensions": ["icd"],
      "xpath": "//*[local-name()='IED' and @type='PowerLogic-P7']//*[local-name()='LN' and (@lnClass='LSVS' or @lnClass='LGOS')]"
    },
    {
      "action": "delete",
      "enabled": true,
      "extensions": ["icd", "iid"],
      "xpath": "//*[local-name()='IED' and @type='PowerLogic-P7']//*[local-name()='LN' and @prefix='TCR' and @lnClass='GLOG' and @inst='1']"
    },
    {
      "action": "delete",
      "enabled": true,
      "extensions": ["icd", "iid"],
      "xpath": "//*[local-name()='IED' and @type='PowerLogic-P7']//*[local-name()='LN' and @prefix='T103' and @lnClass='ITCI' and @inst='1']"
    },
    {
      "action": "delete-attribute",
      "enabled": true,
      "attribute": "pServT",
      "extensions": ["iid"],
      "xpath": "//*[local-name()='IED' and @type='PowerLogic-P7']//*[local-name()='ExtRef' and not(@intAddr) and (@pServT)]"
    },
    {
      "action": "delete-duplicates",
      "enabled": true,
      "attributes": ["version", "revision"],
      "xpath": "//*[local-name()='Hitem']"
    },
    {
      "action": "delete",
      "enabled": true,
      "extensions": ["icd"],
      "xpath": "//*[local-name()='ConnectedAP' and @apName='AP1' and @iedName = //*[local-name()='IED' and @type='PowerLogic-P7']/@name]"
    },
    {
      "action": "replace",
      "enabled": true,
      "extensions": ["icd", "iid"],
      "target": "text",
      "search": "–",
      "replace": "-",
      "xpath": "//{*}Val"
    },
    {
      "action": "replace",
      "enabled": true,
      "extensions": ["icd", "iid"],
      "target": "text",
      "search": "φ",
      "replace": "Phi",
      "xpath": "//*[local-name()='DAI' and @name='d']/*[local-name()='Val']"
    },
    {
      "action": "replace",
      "enabled": true,
      "extensions": ["icd", "iid"],
      "target": "text",
      "search": "µ",
      "replace": "u",
      "xpath": "//*[local-name()='DAI' and @name='d']/*[local-name()='Val']"
    },
    {
      "action": "replace",
      "enabled": true,
      "extensions": ["icd", "iid"],
      "target": "text",
      "search": "616",
      "replace": "99999",
      "xpath": "//{*}Val"
    },
    {
      "action": "set-text",
      "enabled": true,
      "extensions": ["icd", "iid"],
      "value": "s",
      "xpath": "//*[local-name()='DOI' and @name='Tms']/*[local-name()='SDI' and @name='units']/*[local-name()='DAI' and @name='SIUnit']/*[local-name()='Val']"
    },
    {
      "action": "replace-ancestor-attribute",
      "enabled": true,
      "extensions": ["icd", "iid"],
      "ancestor": "IED",
      "attribute": "name",
      "replace": "@",
      "xpath": "//*[local-name()='IED' and @type='PowerLogic-P7']//*[local-name()='DOI' and @name='GrRef']//*[local-name()='DAI' and @name='setSrcRef']//*[local-name()='Val']"
    },
    {
      "action": "rename-data-type-template-id",
      "enabled": false,
      "extensions": ["scd"],
      "search": "ENS_BEH",
      "replace": "ENS_BEH_P7"
    },
    {
      "action": "rename-data-type-template-id",
      "enabled": false,
      "extensions": ["scd"],
      "search": "ENS_HEALTH",
      "replace": "ENS_HEALTH_P7"
    }
  ]
}
